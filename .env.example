# VYOM server configuration
# Without GEMINI_API_KEY the /api/diagnose route runs in deterministic
# rule-based mode ("simulated analysis") — the UI degrades gracefully.
GEMINI_API_KEY=
PORT=3001

# Supabase auth (email + password). Without these, the Access page runs in
# local demo mode (callsign + GAS418S-ALPHA-Q) so the twin works offline.
# Copy from Supabase → Project Settings → API.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Alert SMS (optional). Without these the /api/alerts route runs in dev-test
# mode: it logs the alert server-side and returns 200, so the Scenario Sim
# pipeline works end-to-end with no provider. Fill in to send real SMS via
# Twilio: account SID + auth token, a verified sender (TWILIO_FROM), and the
# recipient number in E.164 form (TWILIO_TO).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
TWILIO_TO=
