{
  "name": "vyom",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "VYOM — AI-enabled real-time digital twin for the Flygas GAS418S engine (DRDO Tapas-BH-201 / Archer Tactical UAV, SIH 2026 PS 26054, Team ALPHA Q)",
  "scripts": {
    "dev": "concurrently -k -n server,web -c yellow,cyan \"npm:dev:server\" \"npm:dev:web\"",
    "dev:web": "vite",
    "dev:server": "tsx watch server/index.ts",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "preview": "vite preview"
  },
  "dependencies": {
    "@google/genai": "^2.21.0",
    "@react-three/drei": "^9.122.0",
    "@react-three/fiber": "^8.18.0",
    "@supabase/server": "^1.5.3",
    "@supabase/supabase-js": "^2.116.0",
    "animejs": "^3.2.2",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "motion": "^13.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.1",
    "recharts": "^2.15.4",
    "three": "^0.170.0",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/animejs": "^3.1.13",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.14",
    "@types/react-dom": "^18.3.2",
    "@types/three": "^0.170.0",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.1.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.19.2",
    "typescript": "~5.6.3",
    "vite": "^6.4.3",
    "vitest": "^2.1.8"
  },
  "allowScripts": {
    "@google/genai@2.21.0": true,
    "esbuild@0.28.2": true,
    "esbuild@0.21.5": true,
    "esbuild@0.25.12": true
  }
}
